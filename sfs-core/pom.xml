<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfs</groupId>
        <artifactId>sfs-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sfs-core</artifactId>
    <packaging>jar</packaging>

    <name>SFS Core</name>
    <description>
        Pure domain model. Object ID, Semantic DNA types, lifecycle types, domain exceptions.
        Milestones 03 and 06 own the contents of this module.
    </description>

    <!--
        ARCHITECTURAL RULE FOR THIS MODULE:

        sfs-core has NO production dependencies. Not Spring, not Jackson, not a logger.

        Reason: the domain model is the one thing every other subsystem depends on.
        If it acquires a framework dependency, that framework leaks into the adapter
        framework, the memory system, the reconstruction model and the evaluation
        system. Keeping it dependency-free is what makes the components replaceable,
        which the specification requires.

        Adding ANY production dependency here requires project owner authorization.
    -->
    <dependencies>
        <!-- Test-scope only, inherited from the parent. Intentionally empty otherwise. -->
    </dependencies>

</project>
